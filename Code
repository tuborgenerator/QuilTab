local function getCharacterInfo(p)
    local ch = p.Character
    if not ch then return "Karakter henüz yüklenmedi" end

    local hum = ch:FindFirstChildOfClass("Humanoid")
    local root = ch:FindFirstChild("HumanoidRootPart")
    local head = ch:FindFirstChild("Head")

    local result = {}
    table.insert(result,"Kullanıcı adı: @"..p.Name)
    table.insert(result,"DisplayName: "..p.DisplayName)
    table.insert(result,"UserId: "..p.UserId)
    table.insert(result,"Takım: "..(p.Team and p.Team.Name or "Yok"))
    table.insert(result,"Karakter: "..ch.Name)

    if hum then
        table.insert(result,string.format(
            "Can: %.0f / %.0f",hum.Health,hum.MaxHealth))
        table.insert(result,"Hareket: "..hum:GetState().Name)
        table.insert(result,"Hız: "..string.format("%.1f",hum.WalkSpeed))
        table.insert(result,"Zıplama: "..string.format("%.1f",hum.JumpPower))
    else
        table.insert(result,"Humanoid: Bulunamadı")
    end

    if root then
        local pos = root.Position
        table.insert(result,string.format(
            "Konum: %.1f, %.1f, %.1f",pos.X,pos.Y,pos.Z))

        local myRoot = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            table.insert(result,string.format(
                "Mesafe: %.1f studs",(myRoot.Position-pos).Magnitude))
        end
    end

    table.insert(result,"Kafa: "..(head and "Mevcut" or "Yüklenmedi"))
    return table.concat(result,"\n")
end

local function updateSelected()
    if selectedPlayer and selectedPlayer.Parent == Players then
        selectedInfo.Text = getCharacterInfo(selectedPlayer)
