local function make(class, parent, props)
    local obj = Instance.new(class)
    for k,v in pairs(props or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    make("UICorner", obj, {
        CornerRadius = UDim.new(0, radius or 9)
    })
end

local function label(parent, value, size, pos, fontSize, color)
    return make("TextLabel", parent, {
        BackgroundTransparency = 1,
        Size = size,
        Position = pos,
        Text = value,
        TextColor3 = color or C.white,
        Font = Enum.Font.Gotham,
        TextSize = fontSize or 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true
    })
end

local function button(parent, value, size, pos, callback)
    local b = make("TextButton", parent, {
        Size = size,
        Position = pos,
        BackgroundColor3 = C.card,
        Text = value,
        TextColor3 = C.white,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        AutoButtonColor = true
    })
    round(b, 7)
    b.Activated:Connect(callback or function() end)
    return b
end

