-- Drag window
local dragging, dragStart, startPos = false,nil,nil

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale,startPos.X.Offset+delta.X,
            startPos.Y.Scale,startPos.Y.Offset+delta.Y)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UIS.InputBegan:Connect(function(input,processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        main.Visible = not main.Visible
        restore.Visible = not main.Visible
    end
end)

-- Live updates
local refreshClock = 0
RunService.RenderStepped:Connect(function(dt)
    if not alive then return end

    frameCount += 1
    frameTime += dt
    refreshClock += dt

    if frameTime >= 1 then
        fps = math.floor(frameCount/frameTime)
        frameCount = 0
        frameTime = 0

        local pingText = "--"
        pcall(function()
            pingText = tostring(math.floor(
                Stats.Network.ServerStatsItem["Data Ping"]:GetValue())).." ms"
        end)

        statsText.Text = string.format(
            "Oyuncular: %d\nFPS: %d\nPing: %s",
            #Players:GetPlayers(),fps,pingText)

        local ch = LP.Character
        local hum = ch and ch:FindFirstChildOfClass("Humanoid")
        local root = ch and ch:FindFirstChild("HumanoidRootPart")

        if hum then
            myInfo.Text = string.format(
                "Can: %.0f / %.0f\nHız: %.1f\nZıplama: %.1f\nDurum: %s\nKonum: %s",
                hum.Health,hum.MaxHealth,hum.WalkSpeed,hum.JumpPower,
                hum:GetState().Name,
                root and tostring(root.Position) or "Yükleniyor")
        else
            myInfo.Text = "Karakter yükleniyor..."
        end
    end

    if refreshClock >= 0.5 then
        refreshClock = 0
        updateSelected()
        if espEnabled then refreshTags() end
    end
end)

