local function refreshPlayers()
    for _,row in pairs(playerRows) do
        row:Destroy()
    end
    table.clear(playerRows)

    local query = string.lower(search.Text)
    local all = Players:GetPlayers()
    table.sort(all,function(a,b)
        return a.Name:lower() < b.Name:lower()
    end)

    for _,p in ipairs(all) do
        if string.find(p.Name:lower(),query,1,true)
        or string.find(p.DisplayName:lower(),query,1,true) then

            local row = make("TextButton",rowsHolder,{
                Name = p.Name,
                Size = UDim2.new(1,0,0,66),
                BackgroundColor3 = p == selectedPlayer and C.red or C.panel,
                Text = "",
                AutoButtonColor = true
            })
            round(row,8)
            playerRows[p] = row

            local avatar = make("ImageLabel",row,{
                Size = UDim2.fromOffset(46,46),
                Position = UDim2.fromOffset(8,10),
                BackgroundColor3 = C.card,
                Image = ""
            })
            round(avatar,100)

            task.spawn(function()
                local ok,img = pcall(function()
                    return Players:GetUserThumbnailAsync(
                        p.UserId,
                        Enum.ThumbnailType.HeadShot,
                        Enum.ThumbnailSize.Size100x100)
                end)
                if ok and avatar.Parent then avatar.Image = img end
            end)

            label(row,p.DisplayName,
                UDim2.new(1,-68,0,20),
                UDim2.fromOffset(62,7),12)
            label(row,"@"..p.Name,
                UDim2.new(1,-68,0,18),
                UDim2.fromOffset(62,27),10,C.muted)

            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            local hp = hum and string.format("Can %.0f/%.0f",hum.Health,hum.MaxHealth)
                or "Karakter bekleniyor"
            label(row,hp,
                UDim2.new(1,-68,0,16),
                UDim2.fromOffset(62,45),9,
                hum and (hum.Health > 0 and C.green or C.bright) or C.muted)

            row.Activated:Connect(function()
                selectedPlayer = p
                refreshPlayers()
                updateSelected()
            end)
        end
    end
end

